{
  "$schema": "./node_modules/wrangler/config-schema.json",

  // Daedalus publicado como BUNDLE ESTATICO em Cloudflare Pages.
  //
  // Nao ha "main": nao existe Worker de codigo, nao existe backend, nao existe
  // API. Isso nao e economia, e requisito — o programa calcula tudo no
  // navegador do usuario, e um endpoint aqui seria um caminho por onde dado de
  // pesquisa poderia sair da maquina dele sem que ninguem tivesse pedido.
  //
  // Pages e nao Workers por causa do endereco: uma URL workers.dev e sempre
  // <worker>.<subdominio-da-conta>.workers.dev, e o subdominio da conta carrega
  // o nome de quem a criou. Em Pages o endereco e so o nome do projeto.
  //
  // O repositorio e privado; o que sobe e o compilado. O nucleo em C aparece no
  // bundle porque o exportador precisa dele para emitir o .cpp autocontido — e
  // o mesmo texto que vai no arquivo exportado, por projeto.
  // (A conta e a 16e69654a3b261532a4433a5c0ea13d0; config de Pages nao aceita
  //  "account_id" — ela vem do login.)
  "name": "daedalus-lab",
  "compatibility_date": "2026-08-28",
  "pages_build_output_dir": "./dist"
}
